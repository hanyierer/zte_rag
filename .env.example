# 豆包 / 火山方舟：只用于 Query 理解和最终 LLM 生成
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=ep-your-doubao-chat-endpoint

# BGE-M3 embedding API。若 embedding 和 rerank 用同一个服务，BGE_RERANK_API_KEY/BGE_RERANK_BASE_URL 可不单独配置。
BGE_API_KEY=your_bge_api_key
BGE_BASE_URL=https://api.siliconflow.cn/v1
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_EMBEDDING_PATH=/embeddings
BGE_REQUIRE_API_KEY=true
BGE_NORMALIZE_QUERY_VECTOR=false

# bge-reranker API
BGE_RERANK_ENABLED=true
BGE_RERANK_API_KEY=your_bge_rerank_api_key
BGE_RERANK_BASE_URL=https://api.siliconflow.cn/v1
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BGE_RERANK_PATH=/rerank
BGE_RERANK_REQUIRE_API_KEY=true

# Milvus REST
MILVUS_ENDPOINT=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_DATABASE=default
MILVUS_COLLECTION=game_knowledge
MILVUS_ID_FIELD=id
MILVUS_TEXT_FIELD=content
MILVUS_DENSE_FIELD=vector
MILVUS_SPARSE_FIELD=text_sparse
